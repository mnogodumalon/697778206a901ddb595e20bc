  const [taeglicher_check_inCount, setTaeglicherCheckInCount] = useState(0);
  const [taegliche_eintraegeCount, setTaeglicheEintraegeCount] = useState(0);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadStats() {
      try {
        const [gewohnheiten_verwaltungData, taeglicher_check_inData, taegliche_eintraegeData] = await Promise.all([
          LivingAppsService.getGewohnheitenVerwaltung(),
          LivingAppsService.getTaeglicherCheckIn(),
          LivingAppsService.getTaeglicheEintraege(),
        ]);
        setGewohnheitenVerwaltungCount(gewohnheiten_verwaltungData.length);
        setTaeglicherCheckInCount(taeglicher_check_inData.length);
        setTaeglicheEintraegeCount(taegliche_eintraegeData.length);
      } catch (e) {
        console.error('Failed to load stats:', e);
      } finally {
        setLoading(false);
      }
    }
    loadStats();
  }, []);

  return (
    <div className="space-y-8">
      {/* === HERO SECTION — Customize with gradient, welcome text, key metrics === */}
      <div>
        <h1 className="text-3xl font-bold tracking-tight">Willkommen</h1>
