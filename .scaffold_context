      </div>

      {/* === KPI CARDS — Customize with icons, colors, descriptions === */}
      <div className="grid grid-cols-2 lg:grid-cols-3 gap-4">
        <StatCard
          title="Gewohnheiten-Verwaltung"
          value={loading ? '...' : gewohnheiten_verwaltungCount}
          description="Gewohnheiten-Verwaltung im System"
        />
        <StatCard
          title="Täglicher Check-in"
          value={loading ? '...' : taeglicher_check_inCount}
          description="Täglicher Check-in im System"
        />
        <StatCard
          title="Tägliche Einträge"
          value={loading ? '...' : taegliche_eintraegeCount}
          description="Tägliche Einträge im System"
        />
      </div>

      {/* === CHARTS / CONTENT — Build your dashboard here === */}
      {/* Ideas: recharts BarChart/LineChart, upcoming items list, recent activity feed */}
